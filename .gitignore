backend/alembic/__pycache__/

# ── infra / deployment ────────────────────────────────────────────────────────
# keep infra/ folder in repo — nginx configs are intentional
# ignore terraform state + sensitive infra files
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

