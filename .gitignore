# ── editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*~

# ── env files ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log.*

# ── secrets / sensitive ───────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.csr
secrets/
.secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
.turbo/
.vercel/
.yarn/
.pnp.*
*.tgz

# ── database ──────────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── uploads / media (user-generated content) ─────────────────────────────────
uploads/
media/

# ── alembic ───────────────────────────────────────────────────────────────────
